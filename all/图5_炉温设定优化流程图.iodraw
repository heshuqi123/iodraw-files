<mxGeometry x="170" y="336" width="560" height="45" as="geometry"/>
</mxCell><mxCell id="jdec" value="j ≤ N_c ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#2F5597;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#000000;spacing=8;" vertex="1" parent="1">
<mxGeometry x="355" y="404" width="190" height="82" as="geometry"/>
</mxCell><mxCell id="gen" value="在邻域内生成候选设定方案 u^(j) = u^(0) + ε_j" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3F8;strokeColor=#2F5597;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#000000;spacing=8;" vertex="1" parent="1">
<mxGeometry x="170" y="514" width="560" height="52" as="geometry"/>
</mxCell><mxCell id="concat" value="构造候选工况 x̄_j = Concat(x_state, u^(j))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3F8;strokeColor=#2F5597;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#000000;spacing=8;" vertex="1" parent="1">
<mxGeometry x="170" y="589" width="560" height="52" as="geometry"/>
