        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DDEBF7;strokeColor=#2F5597;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="370" y="1431" width="160" height="45" as="geometry" />
